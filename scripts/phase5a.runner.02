ss\'] is False\\n          assert oa_tight[\'metrics\'][\'success\'] is True, oa_tight[\'metrics\']\\n          for side, expected_y in [(\'left\', 0.1535), (\'right\', -0.1535)]:\\n              ee = oa[\'referenceMapping\'][side + \'HomeEePositionM\']\\n              assert abs(ee[0] - 0.401) < 0.003 and abs(ee[1] - expected_y) < 0.003 and abs(ee[2] - 1.120) < 0.003, (side, ee)\\n          for name in (\'flaskFinalPositionM\', \'beakerFinalPositionM\'):\\n              a = oa[\'metrics\'][name]; b = oa_tight[\'metrics\'][name]\\n              delta = math.sqrt(sum((x-y)**2 for x,y in zip(a,b)))\\n              assert delta <= 0.02, (name, a, b, delta)\\n          print(\'Native OpenArm V2 Phase 5A nominal/negative/sensitivity references: OK\')\\n          PY", 1]]')
def repl(path,old,new,count):
 p=ROOT/path; t=p.read_text()
 if old not in t: raise SystemExit(f'anchor missing {path}: {old[:120]!r}')
 p.write_text(t.replace(old,new,count))
with zipfile.ZipFile(io.BytesIO(base64.b64decode(PAYLOAD))) as z:
 for name in z.namelist():
  p=ROOT/name; p.parent.mkdir(parents=True,exist_ok=True); p.write_bytes(z.read(name))
for path,old,new,count in PATCHES: repl(path,old,new,count)
p=ROOT/'README.md'; t=p.read_text(); needle='Version `0.2.0-alpha.2` completes the SO-101 physical migration milestone: the normal SO-101 workspace, live Python, renderer, task evaluator, and bounded WebMCP controls share one authoritative browser MuJoCo PhysicsSession.' + chr(10)
if needle not in t: raise SystemExit('README anchor missing')
extra=needle + chr(10) + 'Phase 5A also migrates the normal OpenArm V2 `openarm-04-filtration-workcell` task to a single-authority bimanual MuJoCo workspace on the isolated migration branch. It preserves the pinned V2 mirrored joint/actuator semantics, uses true free-body dry vessels, source-defined mechanical finger coupling only, simulation-time async Python, causal contact/support task evaluation, and bounded OpenArm WebMCP control. Primitive browser collision surrogates and the synthetic dry workcell remain simulator approximations; hardware calibration is pending.' + chr(10)
p.write_text(t.replace(needle,extra,1))
print('OpenArm Phase 5A payload applied')
